{
  "name": "@lokomotif/schema",
  "version": "0.0.0",
  "description": "JSON Schema and TypeScript validator for Lokomotif RTCSG modules.",
  "license": "Apache-2.0",
  "homepage": "https://kit.lokomotif.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lokomotifai/lokomotif-kit.git",
    "directory": "packages/schema"
  },
  "bugs": {
    "url": "https://github.com/lokomotifai/lokomotif-kit/issues"
  },
  "author": {
    "name": "Lokomotif Core Team",
    "email": "kit@lokomotif.ai"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": "./schemas/module.schema.json",
    "./schema/raw": {
      "types": "./dist/load-schema.d.ts",
      "default": "./dist/load-schema.js"
    }
  },
  "files": [
    "dist/",
    "schemas/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src scripts __tests__",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:modules": "tsx scripts/validate-modules.ts",
    "generate": "pnpm generate:ts && pnpm generate:py",
    "generate:ts": "tsx scripts/generate-types.ts",
    "generate:py": "tsx scripts/generate-python.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@vitest/coverage-v8": "^2.1.8",
    "fast-glob": "^3.3.2",
    "json-schema-to-typescript": "^15.0.3",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  }
}
