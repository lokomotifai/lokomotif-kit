{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": ".turbo/tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["__tests__", "scripts", "vitest.config.ts", "dist", "node_modules", ".turbo"]
}
