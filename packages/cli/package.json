{
  "name": "@lokomotif/cli",
  "version": "0.1.0",
  "description": "The lokomotif command-line tool. List, validate, scaffold, compose, evaluate, and deploy RTCSG modules.",
  "license": "Apache-2.0",
  "homepage": "https://kit.lokomotif.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lokomotifai/lokomotif-kit.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/lokomotifai/lokomotif-kit/issues"
  },
  "author": {
    "name": "Lokomotif Core Team",
    "email": "kit@lokomotif.ai"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "lokomotif": "./bin/lokomotif.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src __tests__",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@lokomotif/schema": "workspace:*",
    "@lokomotif/sdk": "workspace:*",
    "clipanion": "^4.0.0-rc.4",
    "fast-glob": "^3.3.2",
    "picocolors": "^1.1.1",
    "typanion": "^3.14.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@vitest/coverage-v8": "^2.1.8",
    "execa": "^9.5.2",
    "vitest": "^2.1.8"
  }
}
