{
  "name": "@lokomotif/blueprint-n8n",
  "version": "0.1.0",
  "description": "Adapt Lokomotif RTCSG flows to n8n workflow JSON.",
  "license": "Apache-2.0",
  "homepage": "https://kit.lokomotif.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lokomotifai/lokomotif-kit.git",
    "directory": "blueprints/n8n"
  },
  "bugs": {
    "url": "https://github.com/lokomotifai/lokomotif-kit/issues"
  },
  "author": {
    "name": "Lokomotif Core Team",
    "email": "kit@lokomotif.ai"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src __tests__",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@lokomotif/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^2.1.8",
    "vitest": "^2.1.8"
  }
}
